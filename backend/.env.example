APP_ENV=development
APP_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
APP_LOG_LEVEL=INFO
# Optional, non-commercial weather provider. Leave blank to keep weather unconfigured.
APP_WEATHER_PROVIDER=
# Optional model configuration. Never commit real values.
APP_MODEL_BASE_URL=
APP_MODEL_NAME=
APP_MODEL_API_KEY=
APP_MODEL_TIMEOUT_SECONDS=30
# Optional flight fare provider. Leave provider blank to keep fares unconfigured.
APP_TRANSPORT_FARE_PROVIDER=
APP_TRANSPORT_AMADEUS_ENV=test
APP_TRANSPORT_AMADEUS_CLIENT_ID=
APP_TRANSPORT_AMADEUS_CLIENT_SECRET=
APP_TRANSPORT_AMADEUS_TIMEOUT_SECONDS=8
APP_TRANSPORT_AMADEUS_MAX_RESPONSE_BYTES=262144

# Optional railway queries through the pinned official CLI (run scripts/setup_flyai.py).
APP_TRANSPORT_TRAIN_PROVIDER=
FLYAI_API_KEY=
APP_TRANSPORT_FLYAI_NODE_PATH=node
APP_TRANSPORT_FLYAI_TIMEOUT_SECONDS=45
APP_TRANSPORT_FLYAI_MAX_RESPONSE_BYTES=1048576
